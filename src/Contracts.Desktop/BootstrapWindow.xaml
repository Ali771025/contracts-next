<Window x:Class="Contracts.Desktop.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی امن" Width="460" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Language="fa-IR" AutomationProperties.AutomationId="BootstrapWindow">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="ایجاد مدیر اولیه" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBox Grid.Row="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8" AutomationProperties.Name="نام کاربری" AutomationProperties.AutomationId="BootstrapUsername"/>
    <TextBox Grid.Row="2" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="8" AutomationProperties.Name="نام کامل" AutomationProperties.AutomationId="BootstrapDisplayName"/>
    <PasswordBox x:Name="PasswordInput" Grid.Row="3" Margin="0,0,0,12" Padding="8" AutomationProperties.Name="گذرواژه قوی" AutomationProperties.AutomationId="BootstrapPassword"/>
    <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" MinHeight="55"/>
    <Button Grid.Row="5" Content="ایجاد امن" Padding="18,7" HorizontalAlignment="Left" Click="HandleCreate" AutomationProperties.AutomationId="BootstrapCreate"/>
  </Grid>
</Window>
