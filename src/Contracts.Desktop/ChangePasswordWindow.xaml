<Window x:Class="Contracts.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییر گذرواژه" Width="430" Height="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Language="fa-IR">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="گذرواژه جدید و قوی وارد کنید" FontSize="20" Margin="0,0,0,18"/>
    <PasswordBox x:Name="PasswordInput" Grid.Row="1" Margin="0,0,0,12" Padding="8"/>
    <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" MinHeight="50"/>
    <Button Grid.Row="3" Content="ثبت گذرواژه" Padding="18,7" HorizontalAlignment="Left" Click="HandleChange"/>
  </Grid>
</Window>
