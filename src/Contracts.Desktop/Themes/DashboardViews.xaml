<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Contracts.Desktop.Dashboard" xmlns:controls="clr-namespace:Contracts.Desktop.Controls" xmlns:dashboard="clr-namespace:Contracts.Desktop.Dashboard">
  <DataTemplate DataType="{x:Type vm:DashboardPageViewModel}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><controls:PageHeader Header="{Binding Title}" Content="شاخص‌های منبع‌محور با snapshot و drill-down قابل تطبیق"/><WrapPanel><controls:PersianDatePicker Width="140" Text="{Binding DateFrom}" ToolTip="از تاریخ شمسی"/><controls:PersianDatePicker Width="140" Text="{Binding DateTo}" ToolTip="تا تاریخ شمسی"/><TextBox Width="90" Text="{Binding ContractTypeId}" ToolTip="شناسه نوع قرارداد"/><TextBox Width="90" Text="{Binding ContractStatusId}" ToolTip="شناسه وضعیت"/><TextBox Width="90" Text="{Binding PartyId}" ToolTip="شناسه طرف"/><TextBox Width="90" Text="{Binding ProjectId}" ToolTip="شناسه پروژه"/><Button Content="تازه‌سازی" Command="{Binding RefreshCommand}"/></WrapPanel><controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError,Converter={StaticResource MasterDataBooleanToVisibility}}"/></StackPanel>
      <Grid Grid.Row="1"><dashboard:DashboardPreviewControl Html="{Binding Html}" DrilldownCommand="{Binding SelectDrilldownCommand}"/><controls:LoadingOverlay IsLoading="{Binding IsBusy}"/></Grid>
      <Expander Grid.Row="2" Header="{Binding DrilldownTitle}" IsExpanded="{Binding IsDrilldownVisible,Mode=OneWay}" Visibility="{Binding IsDrilldownVisible,Mode=OneWay,Converter={StaticResource MasterDataBooleanToVisibility}}" MaxHeight="280">
        <TabControl><TabItem Header="قراردادها"><DataGrid ItemsSource="{Binding DrilldownContracts}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="شماره" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="طرف" Binding="{Binding PartyName}"/><DataGridTextColumn Header="ارزش نهایی" Binding="{Binding FinalValueRial,StringFormat=N0}"/><DataGridTextColumn Header="طلب" Binding="{Binding ReceivableRial,StringFormat=N0}"/><DataGridTextColumn Header="بدهی" Binding="{Binding PayableRial,StringFormat=N0}"/><DataGridTextColumn Header="مطالبه" Binding="{Binding TotalClaimsRial,StringFormat=N0}"/><DataGridTextColumn Header="وصول" Binding="{Binding SettledClaimsRial,StringFormat=N0}"/><DataGridTextColumn Header="تعهد" Binding="{Binding TotalDebtsRial,StringFormat=N0}"/><DataGridTextColumn Header="تسویه" Binding="{Binding SettledDebtsRial,StringFormat=N0}"/><DataGridTextColumn Header="پرداخت" Binding="{Binding TotalPaymentsRial,StringFormat=N0}"/><DataGridTextColumn Header="دریافت" Binding="{Binding TotalReceiptsRial,StringFormat=N0}"/></DataGrid.Columns></DataGrid></TabItem>
          <TabItem Header="هشدارها"><DataGrid ItemsSource="{Binding DrilldownAlerts}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="اولویت" Binding="{Binding PriorityTitle}"/><DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}"/></DataGrid.Columns></DataGrid></TabItem>
          <TabItem Header="شواهد"><DataGrid ItemsSource="{Binding DrilldownEvidence}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="منبع" Binding="{Binding SourceType}"/><DataGridTextColumn Header="شناسه" Binding="{Binding SourceId}"/><DataGridTextColumn Header="شرح" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="صورت" Binding="{Binding Numerator,StringFormat=N0}"/><DataGridTextColumn Header="مخرج" Binding="{Binding Denominator,StringFormat=N0}"/><DataGridTextColumn Header="مقدار" Binding="{Binding Value,StringFormat=N2}"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
      </Expander>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
