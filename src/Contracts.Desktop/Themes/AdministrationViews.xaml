<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Contracts.Desktop.Administration" xmlns:controls="clr-namespace:Contracts.Desktop.Controls">
  <DataTemplate DataType="{x:Type vm:AdministrationPageViewModel}">
    <controls:LoadingOverlay IsLoading="{Binding IsBusy}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <controls:PageHeader Header="تنظیمات، سلامت و بازیابی" Content="پایگاه محلی SQLite؛ حفاظت وابسته به مجوز برنامه و ACL سیستم‌عامل است و امنیت server-grade ادعا نمی‌شود."/>
      <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="درباره سامانه" FontWeight="SemiBold"/><TextBlock Text="{Binding ReleaseVersion}" AutomationProperties.Name="نسخه برنامه"/><TextBlock Text="{Binding WebView2Status}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Muted}" AutomationProperties.Name="وضعیت WebView2"/></StackPanel></Border>
      <controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError,Converter={StaticResource MasterDataBooleanToVisibility}}"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Success}" TextWrapping="Wrap"/>
      <TextBlock Text="تنظیمات سازمانی" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><UniformGrid Columns="2"><controls:FormField Header="نام شرکت"><TextBox Text="{Binding CompanyName}"/></controls:FormField><controls:FormField Header="سربرگ گزارش"><TextBox Text="{Binding ReportHeader}"/></controls:FormField><controls:FormField Header="هشدار قرارداد (روز)"><TextBox Text="{Binding ContractWarningDays}"/></controls:FormField><controls:FormField Header="هشدار ضمانت (روز)"><TextBox Text="{Binding GuaranteeWarningDays}"/></controls:FormField><controls:FormField Header="هشدار مالی (روز)"><TextBox Text="{Binding FinancialWarningDays}"/></controls:FormField><controls:FormField Header="آستانه بحرانی (روز)"><TextBox Text="{Binding CriticalWarningDays}"/></controls:FormField></UniformGrid>
      <TextBlock Text="پشتیبان‌گیری" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><controls:FormField Header="مسیر محلی پشتیبان"><TextBox Text="{Binding BackupPath}"/></controls:FormField><WrapPanel><CheckBox Content="پشتیبان‌گیری خودکار" IsChecked="{Binding AutoBackupEnabled}"/><TextBlock Text="فاصله ساعت" VerticalAlignment="Center"/><TextBox Width="80" Text="{Binding AutoBackupIntervalHours}"/><TextBlock Text="تعداد نگهداری" VerticalAlignment="Center"/><TextBox Width="80" Text="{Binding RetentionCount}"/><Button Content="ذخیره تنظیمات" Command="{Binding SaveCommand}"/><Button Content="ایجاد پشتیبان" Command="{Binding BackupCommand}"/><Button Content="بازیابی بسته…" Command="{Binding RestoreCommand}"/></WrapPanel>
      <TextBlock Text="سلامت سامانه" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/><StackPanel Orientation="Horizontal"><Button Content="بررسی مجدد" Command="{Binding RefreshHealthCommand}"/><TextBlock Text="{Binding HealthSummary}" Margin="12,0" VerticalAlignment="Center"/></StackPanel><DataGrid ItemsSource="{Binding HealthItems}" IsReadOnly="True" AutoGenerateColumns="False" Height="220"><DataGrid.Columns><DataGridTextColumn Header="بررسی" Binding="{Binding Title}"/><DataGridTextColumn Header="وضعیت" Binding="{Binding State}"/><DataGridTextColumn Header="جزئیات" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="اقدام" Binding="{Binding Action}" Width="220"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="اطلاعات پایه" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6"/><ContentControl Content="{Binding Lookups}"/>
    </StackPanel></ScrollViewer></controls:LoadingOverlay>
  </DataTemplate>
</ResourceDictionary>
