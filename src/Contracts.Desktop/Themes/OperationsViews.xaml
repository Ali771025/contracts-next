<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Contracts.Desktop.Operations" xmlns:controls="clr-namespace:Contracts.Desktop.Controls">
  <DataTemplate DataType="{x:Type vm:OperationsPageViewModel}">
    <Grid Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource MasterDataBooleanToVisibility}}"/>
      <Grid Grid.Row="1" Visibility="{Binding IsAmendments, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Amendments}" SelectedItem="{Binding SelectedAmendment}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="شماره" Binding="{Binding Number}"/><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}"/><DataGridTextColumn Header="تغییر مبلغ" Binding="{Binding AmountChangeRial, StringFormat=N0}"/><DataGridTextColumn Header="تمدید" Binding="{Binding TimeExtensionDays}"/><DataGridTextColumn Header="مبلغ نهایی" Binding="{Binding FinalAmountRial, StringFormat=N0}"/><DataGridTextColumn Header="پایان مؤثر" Binding="{Binding EffectiveEndDate}"/></DataGrid.Columns></DataGrid>
        <ScrollViewer Grid.Column="1"><StackPanel Margin="12,0"><controls:PageHeader Header="الحاقیه قرارداد"/><ContentControl Content="{Binding}" Template="{DynamicResource OperationsEditorButtons}"/><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ContractId}"/></controls:FormField><controls:FormField Header="شماره"><TextBox Text="{Binding Number}"/></controls:FormField><controls:FormField Header="تاریخ"><controls:PersianDatePicker Text="{Binding Date}"/></controls:FormField><controls:FormField Header="موضوع"><TextBox Text="{Binding Subject}"/></controls:FormField><controls:FormField Header="تغییر مبلغ ریال (با علامت)"><controls:MoneyField Text="{Binding AmountRial}"/></controls:FormField><controls:FormField Header="روز تمدید"><TextBox Text="{Binding TimeExtensionDays}"/></controls:FormField><controls:FormField Header="پیوست نسبی"><TextBox Text="{Binding AttachmentPath}"/></controls:FormField><controls:FormField Header="شرح"><TextBox Text="{Binding Description}" AcceptsReturn="True"/></controls:FormField></StackPanel></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1" Visibility="{Binding IsGuarantees, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Guarantees}" SelectedItem="{Binding SelectedGuarantee}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="شماره" Binding="{Binding Number}"/><DataGridTextColumn Header="نوع" Binding="{Binding TypeTitle}"/><DataGridTextColumn Header="بانک" Binding="{Binding BankTitle}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountRial, StringFormat=N0}"/><DataGridTextColumn Header="انقضا" Binding="{Binding ExpiryDate}"/><DataGridTextColumn Header="وضعیت مؤثر" Binding="{Binding StatusTitle}"/></DataGrid.Columns></DataGrid>
        <ScrollViewer Grid.Column="1"><StackPanel Margin="12,0"><controls:PageHeader Header="ضمانت‌نامه"/><ContentControl Content="{Binding}" Template="{DynamicResource OperationsEditorButtons}"/><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ContractId}"/></controls:FormField><controls:FormField Header="نوع"><ComboBox ItemsSource="{Binding GuaranteeTypes}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding TypeId}"/></controls:FormField><controls:FormField Header="شماره"><TextBox Text="{Binding Number}"/></controls:FormField><controls:FormField Header="بانک"><ComboBox ItemsSource="{Binding Banks}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding BankId}"/></controls:FormField><controls:FormField Header="صدور"><controls:PersianDatePicker Text="{Binding IssueDate}"/></controls:FormField><controls:FormField Header="انقضا"><controls:PersianDatePicker Text="{Binding ExpiryDate}"/></controls:FormField><controls:FormField Header="مبلغ ریال"><controls:MoneyField Text="{Binding AmountRial}"/></controls:FormField><controls:FormField Header="وضعیت"><ComboBox ItemsSource="{Binding GuaranteeStatuses}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding StatusId}"/></controls:FormField><controls:FormField Header="شرح"><TextBox Text="{Binding Description}"/></controls:FormField></StackPanel></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1" Visibility="{Binding IsInvoices, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="شماره" Binding="{Binding Number}"/><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountRial, StringFormat=N0}"/><DataGridTextColumn Header="ارزش افزوده" Binding="{Binding VatAmountRial, StringFormat=N0}"/><DataGridTextColumn Header="جمع" Binding="{Binding TotalAmountRial, StringFormat=N0}"/><DataGridTextColumn Header="وضعیت پرداخت" Binding="{Binding PaymentStatusTitle}"/></DataGrid.Columns></DataGrid>
        <ScrollViewer Grid.Column="1"><StackPanel Margin="12,0"><controls:PageHeader Header="صورتحساب"/><ContentControl Content="{Binding}" Template="{DynamicResource OperationsEditorButtons}"/><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ContractId}"/></controls:FormField><controls:FormField Header="شماره"><TextBox Text="{Binding Number}"/></controls:FormField><controls:FormField Header="تاریخ"><controls:PersianDatePicker Text="{Binding Date}"/></controls:FormField><controls:FormField Header="نوع"><ComboBox ItemsSource="{Binding InvoiceTypes}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding TypeId}"/></controls:FormField><controls:FormField Header="مبلغ ریال"><controls:MoneyField Text="{Binding AmountRial}"/></controls:FormField><controls:FormField Header="ارزش افزوده ریال"><controls:MoneyField Text="{Binding VatAmountRial}"/></controls:FormField><TextBlock Text="{Binding InvoiceTotal, StringFormat=جمع محاسبه‌شده: {0:N0}}" FontWeight="Bold"/><controls:FormField Header="سررسید اختیاری"><controls:PersianDatePicker Text="{Binding DueDate}"/></controls:FormField><controls:FormField Header="وضعیت پرداخت"><ComboBox ItemsSource="{Binding PaymentStatuses}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding StatusId}"/></controls:FormField><controls:FormField Header="شرح"><TextBox Text="{Binding Description}"/></controls:FormField></StackPanel></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1" Visibility="{Binding IsDocuments, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DataGrid ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="نوع" Binding="{Binding DocumentTypeTitle}"/><DataGridTextColumn Header="نام اصلی" Binding="{Binding OriginalFileName}"/><DataGridTextColumn Header="اندازه" Binding="{Binding Size, StringFormat=N0}"/><DataGridCheckBoxColumn Header="فایل مفقود" Binding="{Binding IsMissing}"/><DataGridTextColumn Header="بارگذار" Binding="{Binding UploadedByDisplayName}"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Column="1" Margin="12,0"><controls:PageHeader Header="اسناد مدیریت‌شده"/><ContentControl Content="{Binding}" Template="{DynamicResource OperationsEditorButtons}"/><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ContractId}"/></controls:FormField><controls:FormField Header="نوع سند"><ComboBox ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding DocumentTypeId}"/></controls:FormField><controls:FormField Header="فایل مبدا"><DockPanel><Button DockPanel.Dock="Left" Content="انتخاب…" Command="{Binding BrowseCommand}"/><TextBox Text="{Binding SourcePath}" IsReadOnly="True"/></DockPanel></controls:FormField><TextBlock Text="فایل در فضای مدیریت‌شده برنامه با نام یکتا و SHA-256 ذخیره می‌شود؛ مسیر مطلق در پایگاه داده ثبت نمی‌شود." TextWrapping="Wrap"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" Visibility="{Binding IsAlerts, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="تولید/همگام‌سازی هشدارها" Command="{Binding GenerateAlertsCommand}"/><Button Content="رفع" Command="{Binding ResolveAlertCommand}"/><Button Content="بازگشایی" Command="{Binding ReopenAlertCommand}"/><Button Content="تازه‌سازی" Command="{Binding RefreshCommand}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="نوع" Binding="{Binding TypeTitle}"/><DataGridTextColumn Header="عنوان" Binding="{Binding Title}"/><DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}"/><DataGridTextColumn Header="اولویت" Binding="{Binding PriorityTitle}"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusTitle}"/><DataGridTextColumn Header="کلید یکتا" Binding="{Binding DeduplicationKey}"/></DataGrid.Columns></DataGrid></Grid>
      <Grid Grid.Row="1" Visibility="{Binding IsEvaluation, Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Evaluations}" SelectedItem="{Binding SelectedEvaluation}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="طرف" Binding="{Binding PartyName}"/><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}"/><DataGridTextColumn Header="کیفیت" Binding="{Binding QualityScore}"/><DataGridTextColumn Header="زمان" Binding="{Binding TimeScore}"/><DataGridTextColumn Header="مالی" Binding="{Binding FinancialScore}"/><DataGridTextColumn Header="HSE" Binding="{Binding HseScore}"/><DataGridTextColumn Header="امتیاز کل" Binding="{Binding TotalScore}"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Column="1"><StackPanel Margin="12,0"><controls:PageHeader Header="ارزیابی پیمانکار"/><ContentControl Content="{Binding}" Template="{DynamicResource OperationsEditorButtons}"/><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ContractId}"/></controls:FormField><controls:FormField Header="تاریخ"><controls:PersianDatePicker Text="{Binding Date}"/></controls:FormField><controls:FormField Header="کیفیت ۰ تا ۱۰۰"><TextBox Text="{Binding QualityScore}"/></controls:FormField><controls:FormField Header="زمان ۰ تا ۱۰۰"><TextBox Text="{Binding TimeScore}"/></controls:FormField><controls:FormField Header="مالی ۰ تا ۱۰۰"><TextBox Text="{Binding FinancialScore}"/></controls:FormField><controls:FormField Header="HSE، ۰ تا ۱۰۰"><TextBox Text="{Binding HseScore}"/></controls:FormField><TextBlock Text="{Binding EvaluationTotal, StringFormat=میانگین مساوی: {0:N1}}" FontWeight="Bold"/><controls:FormField Header="یادداشت"><TextBox Text="{Binding Notes}" AcceptsReturn="True"/></controls:FormField></StackPanel></ScrollViewer></Grid>
      <controls:LoadingOverlay Grid.RowSpan="2" IsLoading="{Binding IsBusy}"/>
    </Grid>
  </DataTemplate>
  <ControlTemplate x:Key="OperationsEditorButtons" TargetType="ContentControl"><StackPanel Orientation="Horizontal"><Button Content="جدید" Command="{Binding NewCommand}"/><Button Content="بازکردن" Command="{Binding OpenCommand}"/><Button Content="ذخیره" Command="{Binding SaveCommand}"/><Button Content="حذف" Command="{Binding DeleteCommand}"/><Button Content="تازه‌سازی" Command="{Binding RefreshCommand}"/></StackPanel></ControlTemplate>
</ResourceDictionary>
