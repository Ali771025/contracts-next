<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Contracts.Desktop.Reporting" xmlns:okr="clr-namespace:Contracts.Desktop.Okr" xmlns:controls="clr-namespace:Contracts.Desktop.Controls" xmlns:reporting="clr-namespace:Contracts.Desktop.Reporting">
  <DataTemplate DataType="{x:Type okr:OkrPageViewModel}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><WrapPanel><TextBlock Text="Overall:" FontWeight="Bold"/><TextBlock Text="{Binding Overall}" Margin="8,0,24,0"/><TextBlock Text="Status:" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Margin="8,0,24,0"/><Button Content="به‌روزرسانی AUTO" Command="{Binding RefreshAutoCommand}"/></WrapPanel><controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError,Converter={StaticResource MasterDataBooleanToVisibility}}"/></StackPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="هدف" Binding="{Binding Objective}" Width="180"/><DataGridTextColumn Header="Objective Score" Binding="{Binding ObjectiveScore}"/><DataGridTextColumn Header="Status" Binding="{Binding ObjectiveStatus}"/><DataGridTextColumn Header="KR" Binding="{Binding Code}"/><DataGridTextColumn Header="نتیجهٔ کلیدی" Binding="{Binding Title}" Width="180"/><DataGridTextColumn Header="Target" Binding="{Binding Target}"/><DataGridTextColumn Header="Weight" Binding="{Binding Weight}"/><DataGridTextColumn Header="Actual" Binding="{Binding Actual}"/><DataGridTextColumn Header="Score" Binding="{Binding Score}"/><DataGridTextColumn Header="Source" Binding="{Binding Source}"/><DataGridTextColumn Header="Provenance" Binding="{Binding Provenance}" Width="*"/></DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,12,0,0"><ComboBox Width="260" ItemsSource="{Binding ManualRows}" SelectedItem="{Binding SelectedManual}" DisplayMemberPath="Title"/><controls:PersianDatePicker Width="140" Text="{Binding MeasurementDate}" ToolTip="تاریخ شمسی"/><TextBox Width="100" Text="{Binding Actual}" ToolTip="مقدار واقعی"/><TextBox Width="300" Text="{Binding Note}" ToolTip="یادداشت و منبع"/><Button Content="ثبت measurement" Command="{Binding SaveManualCommand}"/></WrapPanel>
      <controls:LoadingOverlay Grid.RowSpan="3" IsLoading="{Binding IsBusy}"/>
    </Grid>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:ReportPageViewModel}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel><controls:PageHeader Header="گزارش‌ها" Content="گزارش‌های عمومی، مالی، KPI و OKR قابل ردیابی"/><StackPanel Orientation="Horizontal"><Button Content="گزارش‌های عمومی" Command="{Binding SelectGeneralCommand}"/><Button Content="گزارش‌های مالی" Command="{Binding SelectFinancialCommand}"/><Button Content="گزارشات KPI" Command="{Binding SelectKpiCommand}"/><Button Content="OKR" Command="{Binding SelectOkrCommand}"/></StackPanel></StackPanel>
      <Grid Grid.Row="1" Visibility="{Binding IsReport,Converter={StaticResource MasterDataBooleanToVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel><WrapPanel><ComboBox Width="250" ItemsSource="{Binding Kinds}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedKind}"/><controls:PersianDatePicker Width="140" Text="{Binding DateFrom}" ToolTip="از تاریخ شمسی"/><controls:PersianDatePicker Width="140" Text="{Binding DateTo}" ToolTip="تا تاریخ شمسی"/><TextBox Width="90" Text="{Binding ContractTypeId}" ToolTip="شناسه نوع"/><TextBox Width="90" Text="{Binding ContractStatusId}" ToolTip="شناسه وضعیت"/><TextBox Width="90" Text="{Binding PartyId}" ToolTip="شناسه طرف"/><TextBox Width="90" Text="{Binding ProjectId}" ToolTip="شناسه پروژه"/><Button Content="تولید" Command="{Binding GenerateCommand}"/><Button Content="CSV" Command="{Binding ExportCsvCommand}"/><Button Content="XLSX" Command="{Binding ExportXlsxCommand}"/><Button Content="PDF" Command="{Binding ExportPdfCommand}"/></WrapPanel><controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError,Converter={StaticResource MasterDataBooleanToVisibility}}"/></StackPanel>
        <Grid Grid.Row="1"><reporting:ReportPreviewControl Html="{Binding Html}"/><controls:LoadingOverlay IsLoading="{Binding IsBusy}"/></Grid>
      </Grid>
      <ContentControl Grid.Row="1" Content="{Binding Dashboard}" Visibility="{Binding IsKpi,Converter={StaticResource MasterDataBooleanToVisibility}}"/>
      <ContentControl Grid.Row="1" Content="{Binding Okr}" Visibility="{Binding IsOkr,Converter={StaticResource MasterDataBooleanToVisibility}}"/>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
