<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Contracts.Desktop.Finance" xmlns:controls="clr-namespace:Contracts.Desktop.Controls">
  <DataTemplate DataType="{x:Type vm:FinancePageViewModel}">
    <Grid Margin="16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <controls:ErrorBanner Content="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource MasterDataBooleanToVisibility}}"/>
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="بانک طلب و بدهی"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Obligations}" SelectedItem="{Binding SelectedObligation}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
            <DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="نوع قرارداد" Binding="{Binding ContractTypeTitle}"/><DataGridTextColumn Header="طرف" Binding="{Binding PartyName}"/><DataGridTextColumn Header="طلب/بدهی" Binding="{Binding TransactionTypeTitle}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountRial, StringFormat=N0}"/><DataGridTextColumn Header="مانده" Binding="{Binding RemainingAmountRial, StringFormat=N0}"/><DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}"/><DataGridTextColumn Header="وضعیت" Binding="{Binding StatusTitle}"/><DataGridTextColumn Header="روز تأخیر" Binding="{Binding DaysOverdue}"/>
          </DataGrid.Columns></DataGrid>
          <ScrollViewer Grid.Column="1" Margin="12,0,0,0"><StackPanel><controls:PageHeader Header="تعهد مالی"/><Button Content="جدید" Command="{Binding NewObligationCommand}"/><Button Content="بازکردن انتخاب" Command="{Binding OpenObligationCommand}"/>
            <controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding ObligationContractId}"/></controls:FormField>
            <TextBlock Text="{Binding ObligationContractContext}" IsHitTestVisible="False"/>
            <controls:FormField Header="نوع تراکنش"><ComboBox ItemsSource="{Binding TransactionTypes}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding ObligationTypeId}"/></controls:FormField>
            <CheckBox Content="تغییر صریح نوع پیشنهادی با مجوز تجاری" IsChecked="{Binding ExplicitTypeOverride}"/>
            <controls:FormField Header="تاریخ تراکنش"><controls:PersianDatePicker Text="{Binding ObligationDate}"/></controls:FormField><controls:FormField Header="تاریخ سررسید"><controls:PersianDatePicker Text="{Binding DueDate}"/></controls:FormField>
            <controls:FormField Header="مبلغ ریال"><controls:MoneyField Text="{Binding ObligationAmount}"/></controls:FormField><controls:FormField Header="شرح"><TextBox Text="{Binding ObligationDescription}" AcceptsReturn="True"/></controls:FormField>
            <StackPanel Orientation="Horizontal"><Button Content="ذخیره" Command="{Binding SaveObligationCommand}"/><Button Content="حذف" Command="{Binding DeleteObligationCommand}"/></StackPanel>
          </StackPanel></ScrollViewer></Grid></TabItem>
        <TabItem Header="پرداخت‌ها"><ContentControl Content="{Binding}" Template="{DynamicResource SettlementEditor}"/></TabItem>
        <TabItem Header="دریافت‌ها"><ContentControl Content="{Binding}" Template="{DynamicResource SettlementEditor}"/></TabItem>
      </TabControl><controls:LoadingOverlay Grid.RowSpan="2" IsLoading="{Binding IsBusy}"/>
    </Grid>
  </DataTemplate>
  <ControlTemplate x:Key="SettlementEditor" TargetType="ContentControl"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Settlements}" SelectedItem="{Binding SelectedSettlement}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="شماره" Binding="{Binding Number}"/><DataGridTextColumn Header="قرارداد" Binding="{Binding ContractNo}"/><DataGridTextColumn Header="تاریخ" Binding="{Binding Date}"/><DataGridTextColumn Header="مبلغ" Binding="{Binding AmountRial, StringFormat=N0}"/><DataGridTextColumn Header="تخصیص‌نیافته" Binding="{Binding UnallocatedAmountRial, StringFormat=N0}"/></DataGrid.Columns></DataGrid>
    <ScrollViewer Grid.Column="1" Margin="12,0,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Button Content="جدید" Command="{Binding NewSettlementCommand}"/><Button Content="بازکردن" Command="{Binding OpenSettlementCommand}"/><Button Content="ذخیره" Command="{Binding SaveSettlementCommand}"/><Button Content="حذف" Command="{Binding DeleteSettlementCommand}"/></StackPanel>
      <TextBlock Text="{Binding SettlementContractContext}" FontWeight="SemiBold"/><UniformGrid Columns="3"><controls:FormField Header="قرارداد"><ComboBox ItemsSource="{Binding Contracts}" DisplayMemberPath="ContractNo" SelectedValuePath="Id" SelectedValue="{Binding SettlementContractId}"/></controls:FormField><controls:FormField Header="شماره"><TextBox Text="{Binding SettlementNo}"/></controls:FormField><controls:FormField Header="تاریخ"><controls:PersianDatePicker Text="{Binding SettlementDate}"/></controls:FormField><controls:FormField Header="مبلغ ریال"><controls:MoneyField Text="{Binding SettlementAmount}"/></controls:FormField><controls:FormField Header="روش"><ComboBox ItemsSource="{Binding PaymentTypes}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding PaymentTypeId}"/></controls:FormField><controls:FormField Header="بانک"><ComboBox ItemsSource="{Binding Banks}" DisplayMemberPath="TitleFa" SelectedValuePath="Id" SelectedValue="{Binding BankId}"/></controls:FormField><controls:FormField Header="شماره پیگیری"><TextBox Text="{Binding ReferenceNo}"/></controls:FormField><controls:FormField Header="شماره فاکتور"><TextBox Text="{Binding InvoiceNo}"/></controls:FormField><controls:FormField Header="شماره چک"><TextBox Text="{Binding ChequeNo}"/></controls:FormField><controls:FormField Header="شرح پرداخت‌کننده"><TextBox Text="{Binding PayerDescription}"/></controls:FormField><controls:FormField Header="مسیر پیوست"><TextBox Text="{Binding AttachmentPath}"/></controls:FormField><controls:FormField Header="ثبت‌کننده"><TextBox Text="{Binding RecordedBy,Mode=OneWay}" IsReadOnly="True"/></controls:FormField></UniformGrid>
      <TextBlock Text="تخصیص فقط به تعهدهای باز همان قرارداد انجام می‌شود." FontWeight="SemiBold" Margin="0,8"/><DataGrid ItemsSource="{Binding AllocationEditors}" AutoGenerateColumns="False" MinHeight="150"><DataGrid.Columns><DataGridTextColumn Header="تعهد" Binding="{Binding TransactionNo}" IsReadOnly="True"/><DataGridTextColumn Header="سررسید" Binding="{Binding DueDate}" IsReadOnly="True"/><DataGridTextColumn Header="مانده قابل تخصیص" Binding="{Binding RemainingRial, StringFormat=N0}" IsReadOnly="True"/><DataGridTextColumn Header="مبلغ تخصیص" Binding="{Binding AmountRial, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding UnallocatedDisplay, StringFormat=باقیمانده تخصیص‌نیافته: {0}}" FontWeight="Bold"/><controls:FormField Header="شرح"><TextBox Text="{Binding SettlementDescription}" AcceptsReturn="True"/></controls:FormField>
    </StackPanel></ScrollViewer></Grid></ControlTemplate>
</ResourceDictionary>
