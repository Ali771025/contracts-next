<UserControl x:Class="Contracts.Desktop.Controls.PersianDatePicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" FlowDirection="RightToLeft" MinHeight="36">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="DateText" Text="{Binding Text,RelativeSource={RelativeSource AncestorType=UserControl},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="10,6" AutomationProperties.Name="تاریخ شمسی"/>
    <Button Grid.Column="1" Content="▾" Width="38" MinWidth="38" Padding="0" Margin="4,0,0,0" Click="OpenCalendar" AutomationProperties.Name="باز کردن تقویم شمسی"/>
    <Popup x:Name="CalendarPopup" Grid.ColumnSpan="2" PlacementTarget="{Binding ElementName=DateText}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Width="310">
        <StackPanel>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="ماه بعد" Click="NextMonth" MinWidth="70" Padding="6,3"/><TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="2" Content="ماه قبل" Click="PreviousMonth" MinWidth="70" Padding="6,3"/></Grid>
          <UniformGrid Columns="7" FlowDirection="RightToLeft"><TextBlock Text="ش" TextAlignment="Center"/><TextBlock Text="ی" TextAlignment="Center"/><TextBlock Text="د" TextAlignment="Center"/><TextBlock Text="س" TextAlignment="Center"/><TextBlock Text="چ" TextAlignment="Center"/><TextBlock Text="پ" TextAlignment="Center"/><TextBlock Text="ج" TextAlignment="Center"/></UniformGrid>
          <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6" FlowDirection="RightToLeft" Margin="0,6"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="امروز" Click="SelectToday" Padding="10,3"/><Button Content="پاک‌کردن" Click="ClearDate" Padding="10,3"/></StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
