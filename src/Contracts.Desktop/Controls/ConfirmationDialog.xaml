<Window x:Class="Contracts.Desktop.Controls.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأیید" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Language="fa-IR"
        AutomationProperties.Name="گفتگوی تأیید">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" FontSize="15"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
      <Button Content="ذخیره" IsDefault="True" Click="Save_Click" AutomationProperties.Name="ذخیره تغییرات"/>
      <Button Content="نادیده گرفتن" Margin="8,0" Click="Discard_Click" AutomationProperties.Name="نادیده گرفتن تغییرات"/>
      <Button Content="انصراف" IsCancel="True" Click="Cancel_Click" AutomationProperties.Name="انصراف"/>
    </StackPanel>
  </Grid>
</Window>

